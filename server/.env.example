PORT=5000
NODE_ENV=production

# Optional: default Gmail account. If set, the UI fields can be left blank.
# App Password: https://myaccount.google.com/apppasswords (2-Step Verification must be ON)
GMAIL_USER=
GMAIL_APP_PASSWORD=
FROM_NAME=

# Strongly recommended when the app is reachable from the internet.
# Users must enter this token in the UI before they can use the app.
ACCESS_TOKEN=

# Set to 1 when running behind a reverse proxy (Nginx, Render, Railway, etc.)
TRUST_PROXY=

# Timezone used for the "Sent At" column in the Excel file
TIMEZONE=Asia/Kolkata

MAX_EXCEL_SIZE_MB=10
MAX_ATTACHMENT_TOTAL_MB=18
MAX_ATTACHMENTS=10
MAX_RECIPIENTS=2000
DEFAULT_DELAY_MS=1500
SESSION_TTL_HOURS=24
